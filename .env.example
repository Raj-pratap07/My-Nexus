# Copy this file to ".env" in the project root and fill in real values.
# ".env" is git-ignored. NEVER commit real secrets or paste them into chats.

# --- GitHub MCP server (optional) -------------------------------------------
# Set BOTH or neither. Use a fine-grained personal access token limited to the
# My-Nexus repository with read-only "Contents" and "Metadata" permissions.
GITHUB_TOKEN=replace-with-your-fine-grained-token
GITHUB_MCP_URL=replace-with-your-github-mcp-server-url

# --- Database (required to run the API) -------------------------------------
# URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/my_nexus

# --- Local API identity (required to run the API) ---------------------------
# At least 32 characters (the placeholder below is intentionally too short, so
# the app refuses to start until you replace it). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_DEV_TOKEN=changeme-generate-a-real-token
